# ==============================================================================
# اکوسیستم سلامت دیجیتال پزشکآن - تنظیمات امنیتی سرور (Production Environment)
# ==============================================================================
# برای فعال‌سازی در سرور، این فایل را به .env تغییر نام داده و مقادیر زیر را تنظیم کنید:

# ۱. محیط اجرا (development یا production)
# در حالت production تمامی پیام‌های دیباگ کنسول مخفی و تدابیر امنیتی حداکثری فعال می‌شوند
ENVIRONMENT=production

# ۲. پورت و نشانی اتصال سرور
PORT=3000
HOST=0.0.0.0

# ۳. دامنه و هاست‌های مجاز برای جلوگیری از حمله Host Header Injection
# نمونه: ALLOWED_HOSTS=pezeshkan.com,www.pezeshkan.com,localhost,127.0.0.1
ALLOWED_HOSTS=*

# ۴. مشخصات مدیر کل سامانه (حتماً برای محیط سرور رمز عبور پیچیده انتخاب کنید)
ADMIN_USERNAME=mahyarebrahimi
ADMIN_PASSWORD=CHANGE_ME_TO_A_VERY_STRONG_SECRET_PASSWORD_2026!

# ۵. هش رمز عبور به فرمت استاندارد Argon2id (اختیاری - در صورت تنظیم، رمز متنی در هیچ متغیری ذخیره نمی‌شود)
# نمونه Argon2id:
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$SzPzxix2wJ1rEqkwzG2jXw$ibMSfj0iLaHaLazlOoXInOEjqH+8JYruRNaXCDTWrfM

# ۶. سالت اختصاصی سامانه
SECRET_SALT=pezeshkan_prod_salt_random_secure_key_x99_enterprise

# ۷. فعال‌سازی اجباری کوکی‌های امن (HTTPS)
# در صورتی که وبسایت پشت کلودفلر یا Nginx با SSL فعال است، true قرار دهید
SECURE_COOKIES=false

# ۸. تنظیمات فضای ابری ذخیره‌سازی رسانه مجله (Cloud Object Storage: AWS S3, Cloudflare R2, MinIO, ArvanCloud)
# در حالت پیش‌فرض (false)، تصاویر در پوشه محلی سرور (mag/uploads/YYYY/MM/) با فرمت مدرن WebP و اندازه‌های چندگانه ذخیره می‌شوند
S3_ENABLED=false
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=pezeshkan-media
S3_REGION=auto
# در صورت داشتن دامنه اختصاصی یا CDN (مانند https://cdn.pezeshkan.me):
S3_PUBLIC_DOMAIN=

